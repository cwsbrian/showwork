{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Showwork",
  "version": "0.2.0",
  "identifier": "dev.showwork.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Showwork",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; frame-src 'self' about:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:* https://api.github.com; object-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Library/Application Support/Showwork/projects/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "MIT"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEMDQ4MkI4MzhGRjZDMkQKUldRdGJQODR1SUlFbmFYTmNrZUVqZnhkWlREMWh1dDZRZlNsQlFhQU8yNWNMVEZVa01UT1ZzUkgK",
      "endpoints": [
        "https://github.com/cwsbrian/showwork/releases/latest/download/latest.json"
      ]
    }
  }
}
