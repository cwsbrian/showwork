{
  "name": "showwork",
  "version": "0.4.3",
  "private": true,
  "description": "Install Showwork skills and automatic routing for Codex and Claude Code.",
  "repository": "github:cwsbrian/showwork",
  "bin": { "showwork": "scripts/cli.cjs" },
  "engines": { "node": ">=20" },
  "files": [
    "scripts/cli.cjs",
    "scripts/install_codex.py",
